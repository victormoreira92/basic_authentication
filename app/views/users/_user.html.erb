<div class="card" id="<%= dom_id user %>">
  <div class="card-body">
    <p>
      <strong>Name:</strong>
      <%= user.name %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= user.email %>
    </p>

    <p>
      <strong>Username:</strong>
      <%= user.username %>
    </p>
  </div>

</div>
